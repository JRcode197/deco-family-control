# Copy to .env and set a unique password; never commit .env.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
TZ=Europe/Rome
DATABASE_PATH=/data/family.sqlite3
POLL_SECONDS=60
DECO_MODE=mock
DECO_ROUTER_IP=192.168.21.1
DECO_USERNAME=admin
DECO_PASSWORD=
# Router writes are ALWAYS off until safely tested.
DECO_WRITE_ENABLED=false
PROTECTED_MACS=
QUOTA_ENFORCEMENT=false
BLOCK_ACTUATOR=sdk
HA_URL=
HA_TOKEN=
